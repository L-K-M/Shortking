# Normalize text files across platforms.
* text=auto eol=lf

*.md   text eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.swift text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml  text eol=lf
*.plist text eol=lf
*.editorconfig text eol=lf
Makefile text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.pdf  binary
*.ttf  binary
*.otf  binary
*.jks  binary
*.keystore binary
*.p12  binary
*.cer  binary
*.mobileprovision binary
